                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.client_secret).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.data.client_secret).to.not.eql(pm.collectionVariables.get('clientSecret'));",
                  "  pm.expect(body.data.previousSecretValidUntil).to.be.a('string');",
                  "  pm.collectionVariables.set('rotatedSecret', body.data.client_secret);",
                  "  pm.collectionVariables.set('previousSecretValidUntil', body.data.previousSecretValidUntil);",
                  "});"
                ]
              }
            }
