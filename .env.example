# ============================================================
# .env.example — Environment variable reference
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit a .env file with real credentials to version control.
#
# The application reads these variables at startup.
# All variables have sensible defaults for local development
# defined in application.yml — only override what you need.
# ============================================================

# ============================================================
# SERVER
# ============================================================

# Port the Spring Boot application listens on (default: 8080)
SERVER_PORT=8080

# ============================================================
# DATABASE
# ============================================================

# PostgreSQL connection URL
# For local development: jdbc:postgresql://localhost:5432/insurance_integration
# For Docker Compose:    jdbc:postgresql://postgres:5432/insurance_integration
DB_URL=jdbc:postgresql://localhost:5432/insurance_integration

# PostgreSQL username
DB_USERNAME=postgres

# PostgreSQL password — REPLACE IN PRODUCTION
DB_PASSWORD=postgres

# ============================================================
# SECURITY — JWT
# ============================================================

# Secret key for signing JWT tokens.
# Must be at least 256 bits (32 characters) of high-entropy random data.
# Generate with: openssl rand -base64 32
# REQUIRED IN PRODUCTION — never use the placeholder value.
JWT_SECRET=REPLACE_THIS_WITH_A_SECURE_256_BIT_SECRET_IN_PRODUCTION

# JWT access token expiry in seconds (default: 3600 = 1 hour)
JWT_EXPIRY_SECONDS=3600

# Admin JWT expiry in seconds (default: 86400 = 24 hours)
ADMIN_JWT_EXPIRY_SECONDS=86400

# ============================================================
# AWS — General
# ============================================================

# AWS region (default: us-east-1)
AWS_REGION=us-east-1

# Set to true to use LocalStack for local development (default: false)
AWS_USE_LOCALSTACK=false

# LocalStack or custom endpoint override.
# Leave empty to use real AWS endpoints.
# For LocalStack: http://localhost:4566
AWS_ENDPOINT_OVERRIDE=

# ============================================================
# AWS — SQS
# ============================================================

# URL of the SQS queue used for document transfer jobs
SQS_DOCUMENT_TRANSFER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/document-transfer-queue

# URL of the SQS Dead Letter Queue for failed jobs
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/document-transfer-dlq

# ============================================================
# AWS — SNS
# ============================================================

# ARN of the SNS topic for platform-wide event notifications
SNS_PLATFORM_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:insurance-platform-events

# ============================================================
# DOCUMENT PROCESSING
# ============================================================

# Maximum allowed document upload size in megabytes (default: 50)
DOC_MAX_SIZE_MB=50

# Number of seconds before a pre-signed URL expiry triggers a failure (default: 30)
PRESIGNED_URL_BUFFER_SECONDS=30

# ============================================================
# TRANSFER / RETRY
# ============================================================

# Maximum number of document transfer retry attempts (default: 3)
TRANSFER_MAX_RETRIES=3

# Delay in seconds between retry attempts (default: 60)
TRANSFER_RETRY_DELAY_SECONDS=60

# ============================================================
# OUTBOX POLLER
# ============================================================

# Outbox polling interval in milliseconds (default: 5000 = 5 seconds)
OUTBOX_POLL_MS=5000

# Number of outbox events processed per polling cycle (default: 10)
OUTBOX_BATCH_SIZE=10

# ============================================================
# RATE LIMITING
# ============================================================

# Default API rate limit per partner per minute (default: 100)
RATE_LIMIT_PER_MINUTE=100

# ============================================================
# SPRING PROFILE
# ============================================================

# Active Spring profile.
# Options: local, test, staging, production
# For local development with LocalStack: local
SPRING_PROFILES_ACTIVE=local
